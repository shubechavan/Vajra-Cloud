PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Full path to nginx.exe if it is not in C:\nginx or on PATH
# NGINX_PATH=C:\path\to\nginx-1.30.6\nginx.exe
# NGINX_PORT=8080

# Scaling engine timing (ms). Lower values make demos react faster.
# SCALING_INTERVAL=5000
# SCALING_COOLDOWN=15000
# SCALING_HITS=3

# How often worker stats are polled (ms)
# TRAFFIC_POLL_MS=2000
